cmake_minimum_required(VERSION 3.28.0...3.28.0 FATAL_ERROR)

foreach(var Slicer_SOURCE_DIR TEST_BINARY_DIR TEST_C_COMPILER)
  if(NOT DEFINED ${var})
    message(FATAL_ERROR "${var} is required")
  endif()
endforeach()

foreach(qt_version 5.15 6.8)
  set(root "${TEST_BINARY_DIR}/qt${qt_version}")
  file(REMOVE_RECURSE "${root}")
  file(MAKE_DIRECTORY "${root}/source")
  file(WRITE "${root}/source/FindQt5.cmake" [=[
add_library(Qt5::Network INTERFACE IMPORTED)
set_target_properties(Qt5::Network PROPERTIES QT_ENABLED_PUBLIC_FEATURES gssapi)
set(Qt5_FOUND TRUE)
]=])
  file(WRITE "${root}/source/CMakeLists.txt" "
cmake_minimum_required(VERSION 3.28)
project(GSSAPIStubTest C)
list(PREPEND CMAKE_MODULE_PATH \"${root}/source\")
set(Slicer_REQUIRED_QT_VERSION ${qt_version})
set(Slicer_INSTALL_LIB_DIR lib)
add_subdirectory(\"${Slicer_SOURCE_DIR}/Libs/krb5-gssapi-stub\" stub)
if(Slicer_REQUIRED_QT_VERSION VERSION_GREATER_EQUAL 6)
  if(TARGET krb5-gssapi-stub OR TARGET Qt5::Network)
    message(FATAL_ERROR \"Qt 6 must not build the Qt 5 stub or discover Qt 5\")
  endif()
elseif(NOT TARGET krb5-gssapi-stub)
  message(FATAL_ERROR \"The Qt 5 GSSAPI stub is no longer available\")
endif()
")
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${root}/source" -B "${root}/build"
    "-DCMAKE_C_COMPILER=${TEST_C_COMPILER}" COMMAND_ERROR_IS_FATAL ANY)
endforeach()
message(STATUS "SUCCESS: GSSAPI stub remains restricted to Qt 5")
