cmake_minimum_required(VERSION 3.28.0...3.28.0 FATAL_ERROR)

foreach(var Slicer_SOURCE_DIR TEST_BINARY_DIR)
  if(NOT DEFINED ${var})
    message(FATAL_ERROR "${var} is required")
  endif()
endforeach()

function(check_sql_plugins suffix prefix sqlite_only missing_sqlite)
  set(root "${TEST_BINARY_DIR}/${suffix}-${sqlite_only}-${missing_sqlite}")
  file(REMOVE_RECURSE "${root}")
  file(MAKE_DIRECTORY "${root}/source" "${root}/sdk/sqldrivers" "${root}/sdk/imageformats")
  if(NOT missing_sqlite)
    file(WRITE "${root}/sdk/sqldrivers/${prefix}qsqlite.${suffix}" "SQLite plugin\n")
  endif()
  file(WRITE "${root}/sdk/sqldrivers/${prefix}qsqlpsql.${suffix}" "PostgreSQL plugin\n")
  file(WRITE "${root}/sdk/imageformats/${prefix}qjpeg.${suffix}" "JPEG plugin\n")
  file(WRITE "${root}/source/CMakeLists.txt" "
cmake_minimum_required(VERSION 3.28)
project(QtSQLPluginInstall NONE)
set(CMAKE_BUILD_TYPE Debug)
set(CMAKE_SHARED_LIBRARY_SUFFIX .${suffix})
set(Slicer_INSTALL_QT_SQLITE_ONLY ${sqlite_only})
set(SlicerBlockInstallQtPlugins_subdirectories sqldrivers imageformats)
set(QT_PLUGINS_DIR \"${root}/sdk\")
set(Slicer_INSTALL_QtPlugins_DIR lib/QtPlugins)
include(\"${Slicer_SOURCE_DIR}/CMake/SlicerFunctionInstallLibrary.cmake\")
include(\"${Slicer_SOURCE_DIR}/CMake/SlicerBlockInstallQtPlugins.cmake\")
")
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${root}/source" -B "${root}/build"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(sqlite_only AND missing_sqlite)
    if(result EQUAL 0 OR NOT error MATCHES "SQLite")
      message(FATAL_ERROR "Missing SQLite was not rejected: ${output}\n${error}")
    endif()
    return()
  elseif(NOT result EQUAL 0)
    message(FATAL_ERROR "Plugin fixture configuration failed: ${output}\n${error}")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" --install "${root}/build"
    --prefix "${root}/install" --component RuntimePlugins COMMAND_ERROR_IS_FATAL ANY)
  file(GLOB_RECURSE installed RELATIVE "${root}/install/lib/QtPlugins"
    "${root}/install/lib/QtPlugins/*")
  set(expected "imageformats/${prefix}qjpeg.${suffix}")
  if(NOT missing_sqlite)
    list(APPEND expected "sqldrivers/${prefix}qsqlite.${suffix}")
  endif()
  if(NOT sqlite_only)
    list(APPEND expected "sqldrivers/${prefix}qsqlpsql.${suffix}")
  endif()
  list(SORT installed)
  list(SORT expected)
  if(NOT installed STREQUAL expected)
    message(FATAL_ERROR "Unexpected installed plugins: ${installed}; expected ${expected}")
  endif()
endfunction()

foreach(suffix so dylib dll)
  set(prefix lib)
  if(suffix STREQUAL "dll")
    set(prefix "")
  endif()
  foreach(sqlite_only OFF ON)
    foreach(missing_sqlite OFF ON)
      check_sql_plugins("${suffix}" "${prefix}" "${sqlite_only}" "${missing_sqlite}")
    endforeach()
  endforeach()
endforeach()
message(STATUS "SUCCESS: SQL selection preserves SQLite and unrelated plugins")
